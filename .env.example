# --- Backend API --------------------------------------------------------------
# Set this to your deployed backend URL on Vercel's Environment Variables page.
# No trailing slash. No /api suffix.
# Production example:
#   VITE_API_URL=https://ai-marketing-platform-backend-3mqi.onrender.com
VITE_API_URL=

# --- Google PageSpeed Insights ------------------------------------------------
# Optional. Without a key you get 25 free requests/day (shared quota).
# Get a free key: https://developers.google.com/speed/docs/insights/v5/get-started
VITE_PAGESPEED_API_KEY=
