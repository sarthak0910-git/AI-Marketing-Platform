# ─── Backend (required) ────────────────────────────────────────────────────────
MONGO_URI=
JWT_SECRET=
GROQ_API_KEY=

# ─── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Optional ──────────────────────────────────────────────────────────────────
# Only needed if you split frontend and backend into separate services later.
# Leave blank for the unified single-service deployment.
CLIENT_URL=

# ─── Google PageSpeed Insights (frontend feature) ──────────────────────────────
# Optional. Without a key you get 25 free requests/day.
# Get a free key: https://developers.google.com/speed/docs/insights/v5/get-started
VITE_PAGESPEED_API_KEY=
